# ===== SciFig 国内模型配置（复制为 .env 并填入你的 key）=====
# 复制本文件为 .env 后填写，.env 已被 gitignore，不会上传。

# 快捷选择 provider（可选，覆盖 base/model 默认值）
# qwen | glm | deepseek | openai
SCIFIG_LLM_PROVIDER=deepseek

# OpenAI 兼容端点
SCIFIG_LLM_BASE=https://newapi.ai.gduf.top/v1

# API Key（必填）
SCIFIG_LLM_KEY=sk-xxxxxxxx

# 模型名（按服务商提供的实际名称，如 deepseek-v4-flash / qwen-max / glm-4）
SCIFIG_LLM_MODEL=deepseek-v4-flash

# 流式请求（部分 VLLM 网关非流式会 400，默认 1=开）
SCIFIG_LLM_STREAM=1

# 多模态论文图表解析（推荐单独指定支持图片输入的模型）
# 不填 BASE/KEY 时复用上面的 SCIFIG_LLM_* 配置
# SCIFIG_VISION_PROVIDER=qwen
# SCIFIG_VISION_BASE=https://api.openai.com/v1
# SCIFIG_VISION_KEY=sk-xxxxxxxx
# SCIFIG_VISION_MODEL=gpt-4o
# SCIFIG_VISION_TIMEOUT=300
# SCIFIG_PARSE_VISION_MAX_PAGES=12
# SCIFIG_PARSE_VISION_ALL_PAGES=0

# 输出目录（可选，默认 ./loot）
# SCIFIG_OUT_DIR=./loot

# 外部插件适配器（可选，多个 Python 模块用逗号分隔）
# 模块需提供 register_scifig_plugins(registry)、register(registry)，
# 或 PLUGIN_OVERRIDES = {"render_svg": custom_renderer}
# SCIFIG_PLUGIN_MODULES=my_scifig_plugins
